<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/material_color_picker_used_color_divider_container_width"
        android:layout_height="1dp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/material_color_picker_used_color_divider_container_margin_top"
        android:layout_marginBottom="@dimen/material_color_picker_used_color_divider_container_margin_bottom"
        android:background="?colorOutlineVariant"
        android:gravity="bottom" />

    <LinearLayout
        android:id="@+id/material_color_picker_used_color_item_list_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_oneui_3_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_oneui_3_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_oneui_3_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_oneui_3_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_oneui_3_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_oneui_3_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_oneui_3_used_color_item_size" />
    </LinearLayout>
</LinearLayout>