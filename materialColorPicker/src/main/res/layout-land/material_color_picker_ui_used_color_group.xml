<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginTop="@dimen/material_color_picker_ui_used_color_group_margin"
    android:layout_marginBottom="@dimen/material_color_picker_ui_used_color_group_margin"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="@dimen/material_color_picker_selected_color_group_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/material_color_picker_recently_used_colors"
            android:visibility="visible" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16.0dip"
            android:background="?colorOutlineVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/material_color_picker_used_color_item_list_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_ui_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_ui_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_ui_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_ui_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_ui_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_marginEnd="@dimen/material_color_picker_ui_used_color_item_gap_margin" />

        <View
            android:layout_width="@dimen/material_color_picker_ui_used_color_item_size"
            android:layout_height="@dimen/material_color_picker_ui_used_color_item_size" />
    </LinearLayout>
</LinearLayout>